# Copy the server block to api/.env and the browser block to web/.env.local.
# Values live in the team password group. Never commit real values.

# ---------- server (api/.env): never sent to the browser ----------
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=gpt-6-luna
OPENAI_MODEL_COMPOSE=gpt-6.1-sol
GOOGLE_SERVER_KEY=                   # Places API (New) + Routes only
SUPABASE_URL=
SUPABASE_SECRET_KEY=                 # sb_secret_...
DATABASE_URL=                        # Session pooler string, not the direct one
DEMO_BEARER_TOKEN=
MAPILLARY_ACCESS_TOKEN=
PERCEPTRON_API_KEY=

# ---------- browser (web/.env.local): public by design, no secrets ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_...; RLS protects data
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=         # referrer-restricted, Maps JavaScript API only
